/*
 * Shared defaults for every process.
 *
 * The testing-vs-final guardrail lives in lib/GhistUtils.groovy
 * (`GhistUtils.testingFile()`). Nextflow's config DSL (used for every
 * conf/*.config file, including this one) doesn't allow calling custom
 * functions/classes at parse time - only plain data - so each challenge
 * config just declares a bare filename (e.g. `testing_vcf_name:
 * 'bottleneck.testing.vcf'`). The actual resolution + *.final.* guard
 * happens in the workflow files (workflows/<category>.nf), which run as
 * regular Nextflow/Groovy scripts and can call GhistUtils freely.
 */

params {
    // Per-task ceilings, not whole-run concurrency limits.
    max_cpus   = 4
    max_memory = '16.GB'
    max_time   = '8.h'
}

process {
    cpus   = 2
    memory = '4.GB'
    time   = '2.h'
    resourceLimits = [cpus: params.max_cpus, memory: params.max_memory, time: params.max_time]
    errorStrategy = 'terminate'
}

executor {
    name = 'local'
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_dag.html"
}

report {
    enabled = true
    file = "${params.outdir}/execution_report.html"
}

timeline {
    enabled = true
    file = "${params.outdir}/execution_timeline.html"
}

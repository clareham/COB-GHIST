/*
 * Shared defaults for every process.
 *
 * The testing-vs-final guardrail lives in lib/GhistUtils.groovy
 * (`GhistUtils.testingFile()`). Nextflow's config DSL (used for every
 * conf/*.config file, including this one) doesn't allow calling custom
 * functions/classes at parse time - only plain data - so each challenge
 * config just declares a bare filename (e.g. `testing_vcf_name:
 * 'bottleneck.testing.vcf'`). The actual resolution + *.final.* guard
 * happens in the workflow files (workflows/<category>.nf), which run as
 * regular Nextflow/Groovy scripts and can call GhistUtils freely.
 */

params {
    // Per-task ceilings, not whole-run concurrency limits.
    max_cpus   = 4
    max_memory = '16.GB'
    max_time   = '8.h'
}

process {
    cpus   = 2
    memory = '4.GB'
    time   = '2.h'
    resourceLimits = [cpus: params.max_cpus, memory: params.max_memory, time: params.max_time]
    // Every (challenge, tool) task is independent. With `terminate` the
    // first failure (and queueSize = 1 makes that the *only* running task)
    // aborted the whole survey, so one broken tool hid the results of all
    // others. Failed tasks are still reported as such in the console, the
    // execution report and `nextflow log <run> -f status,name,exit`.
    errorStrategy = 'ignore'
}

executor {
    name = 'local'
    // Serialize all tools/challenges, not just instances of one process.
    queueSize = 1
}

// Nextflow >=23.10 refuses to overwrite these files and aborts the run at
// startup ("Report file already exists ... enable the 'report.overwrite'
// option"), so every rerun (including -resume) into the same outdir failed.
dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_dag.html"
}

report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/execution_report.html"
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/execution_timeline.html"
}

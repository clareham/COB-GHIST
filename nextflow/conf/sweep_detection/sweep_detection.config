/*
 * Category: Sweep Detection
 * Level 1 of the config hierarchy - see conf/genetic_history/genetic_history.config
 * for the overall pattern.
 */

params.sweep_detection = [
    enabled   : params.run_sweep_detection,
    challenges: [:]
]

includeConfig 'onesweep.config'
includeConfig 'onesweep_bgs.config'
includeConfig 'softsweep.config'
includeConfig 'multisweep_bgs.config'

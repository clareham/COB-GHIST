/*
 * Challenge: multisweep_bgs (level 2)
 * Multiple concurrent selective sweeps, confounded by background
 * selection. Human chr7-like contig, accessible-region mask available.
 */
params.sweep_detection.challenges.multisweep_bgs = [
    enabled        : params.sweep_detection.enabled,
    description    : 'Multiple selective sweeps, confounded by background selection.',
    input_type     : 'vcf',
    testing_vcf_name    : 'multisweep_bgs.testing.vcf',
    accessible_bed : "${params.data_dir}/7.accessible.bed",
    submission_bed_example: "${params.data_dir}/sweep_submission.example.bed",

    tools: [
        sweepfinder2: [ enabled: true,  status: 'runnable', conda: 'bioconda::sweepfinder2 bioconda::cyvcf2', args: '-l 1000', options: [folded: true] ],
        // Expensive CPU training from scratch; independent-window survey, no BGS/multi-sweep simulation.
        flexsweep:    [ enabled: true, status: 'survey',
                        conda: 'bioconda::flexsweep=2.0 bioconda::htslib=1.21', args: '',
                        options: [
                            threads: 4, simulations_per_class: 1000,
                            effective_population_size: 10000,
                            mutation_rate: '5e-9,2e-8',
                            recombination_rate: '1e-10,1e-7,1e-8',
                            selection_coefficients: '0.01,0.05',
                            sweep_time_generations: '0,5000',
                            soft_start_frequency: '0,0.1', incomplete_end_frequency: '0.5,1',
                            locus_length: 1200000, window_size: 100000,
                            statistic_step: 100000, scan_step: 100000,
                            min_accessible_fraction: 0.8, sweep_probability: 0.9,
                            ancestral_mode: 'reference', keep_simulations: false,
                        ],
                        reason: 'Constant-Ne/no-BGS exploratory training: 1000 neutral + 1000 mixed hard/soft sweeps; phased diploid GT and REF-ancestral assumption required.' ],
        sweed:        [ enabled: false, status: 'stub', reason: 'No conda/PyPI package found - compile from source manually, then flip enabled: true.' ],
        omegaplus:    [ enabled: false, status: 'stub', reason: 'No conda/PyPI package found - compile from source manually, then flip enabled: true.' ],
        raisd:        [ enabled: false, status: 'stub', reason: 'No conda/PyPI package; needs a manual GSL-linked source build. Skipped by request - revisit only if a prebuilt binary/container turns up.' ],
        timesweeper:  [ enabled: false, status: 'excluded', reason: 'Designed for serial/time-series samples; this challenge is a single present-day sampling.' ],
    ]
]

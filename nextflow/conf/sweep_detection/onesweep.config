/*
 * Challenge: onesweep (level 2)
 * Single hard selective sweep. Human chr7-like contig (159.3 Mb),
 * accessible-region mask available (7.accessible.bed).
 */
params.sweep_detection.challenges.onesweep = [
    enabled        : params.sweep_detection.enabled,
    description    : 'Single hard selective sweep.',
    input_type     : 'vcf',
    testing_vcf_name    : 'onesweep.testing.vcf',
    accessible_bed : "${params.data_dir}/7.accessible.bed",
    submission_bed_example: "${params.data_dir}/sweep_submission.example.bed",

    tools: [
        sweepfinder2: [ enabled: true,  status: 'runnable', conda: 'bioconda::sweepfinder2 bioconda::cyvcf2', args: '-l 1000' ],
        flexsweep:    [ enabled: false, status: 'stub', conda: 'bioconda::flexsweep', args: '',
                        reason: 'Needs feature extraction and a trained classifier wired through the documented Flex-Sweep subcommands.' ],
        sweed:        [ enabled: false, status: 'stub', reason: 'No conda/PyPI package found - compile from source manually, then flip enabled: true.' ],
        omegaplus:    [ enabled: false, status: 'stub', reason: 'No conda/PyPI package found - compile from source manually, then flip enabled: true.' ],
        raisd:        [ enabled: false, status: 'stub', reason: 'No conda/PyPI package; needs a manual GSL-linked source build. Skipped by request - revisit only if a prebuilt binary/container turns up.' ],
        timesweeper:  [ enabled: false, status: 'excluded', reason: 'Designed for serial/time-series samples (ancient + modern); this challenge is a single present-day sampling, so there is no time axis for it to use.' ],
    ]
]

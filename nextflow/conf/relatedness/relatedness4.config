/*
 * Challenge: relatedness4 (level 2)
 * Pedigree-scale cohort (317 samples, the largest of the four), full
 * human (GRCh37-like) genome.
 */
params.relatedness.challenges.relatedness4 = [
    enabled    : params.relatedness.enabled,
    description: 'Relatedness/pedigree inference, human genome, 317 samples.',
    input_type : 'vcf',
    testing_vcf_name: 'relatedness4.testing.vcf',

    tools: [
        king_plink: [ enabled: true,  status: 'runnable', conda: 'bioconda::king bioconda::plink2', args: '' ],
        ngsrelate:  [ enabled: true,  status: 'runnable', conda: 'bioconda::ngsrelate bioconda::bcftools bioconda::htslib', args: '' ],
        admixture:  [ enabled: true,  status: 'runnable', conda: 'bioconda::admixture bioconda::plink2', args: '--cv', k: 3 ],
        shapeit5:   [ enabled: true,  status: 'runnable', conda: 'bioconda::shapeit5 bioconda::bcftools bioconda::htslib', args: '',
                      reason: 'No genetic map provided, falls back to a constant recombination rate.' ],
        read_kin:   [ enabled: false, status: 'stub', reason: 'READ and KIN are standalone GitHub Python scripts, not packaged on conda/PyPI - clone + install manually.' ],
        icmlkin:    [ enabled: false, status: 'stub', reason: 'No conda/PyPI package found - needs a from-source build.' ],
        grups_rs:   [ enabled: false, status: 'stub', reason: 'Rust crate, would need `cargo install` (source build) - skipped per the same compile-from-source policy as RAiSD.' ],
    ]
]

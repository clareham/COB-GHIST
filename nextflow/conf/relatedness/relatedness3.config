/*
 * Challenge: relatedness3 (level 2)
 * Pedigree-scale cohort (68 samples), dog (CanFam3.1-like, 38 autosomes)
 * genome - the one non-human species in the relatedness set. Same tool
 * set as relatedness2/4 since these are species-agnostic genotype-based
 * methods, but defaults (e.g. ADMIXTURE's K) may need retuning.
 */
params.relatedness.challenges.relatedness3 = [
    enabled    : params.relatedness.enabled,
    description: 'Relatedness/pedigree inference, dog genome, 68 samples.',
    input_type : 'vcf',
    autosomes  : 38,
    testing_vcf_name: 'relatedness3.testing.vcf',

    tools: [
        king_plink: [ enabled: true,  status: 'runnable', conda: 'bioconda::plink2', args: '' ],
        ngsrelate:  [ enabled: true,  status: 'runnable', conda: 'bioconda::ngsrelate bioconda::bcftools bioconda::htslib', args: '' ],
        admixture:  [ enabled: true,  status: 'runnable', conda: 'bioconda::admixture bioconda::plink2', args: '--cv', k: 3 ],
        shapeit5:   [ enabled: false, status: 'excluded', conda: 'bioconda::shapeit5 bioconda::bcftools bioconda::htslib', args: '',
                      reason: 'Testing genotypes are already phased; rephasing is unnecessary and is not a relatedness estimate.' ],
        read_kin:   [ enabled: false, status: 'stub', reason: 'READ and KIN are standalone GitHub Python scripts, not packaged on conda/PyPI - clone + install manually.' ],
        icmlkin:    [ enabled: false, status: 'stub', reason: 'No conda/PyPI package found - needs a from-source build.' ],
        grups_rs:   [ enabled: false, status: 'stub', reason: 'Rust crate, would need `cargo install` (source build) - skipped per the same compile-from-source policy as RAiSD.' ],
    ]
]

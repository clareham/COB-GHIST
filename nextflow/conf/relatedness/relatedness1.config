/*
 * Challenge: relatedness1 (level 2)
 * DATA/TOOL MISMATCH: the provided testing data is already a table of
 * pairwise IBD segments (indID1, indID2, chr, start_bp, end_bp, type,
 * start_cM, end_cM, length), not genotypes/sequence. Every tool
 * catalogued in docs/existingtools.md (KING, PLINK, NgsRelate, ADMIXTURE,
 * SHAPEIT5, ...) expects genotype/sequence input and computes IBD/kinship
 * itself - none of them take a pre-computed IBD segment list as primary
 * input. This looks like a distinct task (e.g. pedigree reconstruction
 * from given IBD sharing, closer to tools like CREST/Bonsai/PRIMUS, which
 * aren't in the current catalogue).
 *
 * Left with an empty tools map on purpose rather than forcing a bad fit -
 * fill in once the actual expected task/tool is confirmed.
 */
params.relatedness.challenges.relatedness1 = [
    enabled    : params.relatedness.enabled,
    description: 'Relatedness challenge 1 - input is pairwise IBD segments, not genotypes (see note above).',
    input_type : 'ibd_segments_csv',
    testing_csv_name: 'relatedness1.testing.csv',

    tools: [:]
]

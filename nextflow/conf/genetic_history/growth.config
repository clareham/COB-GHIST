/*
 * Challenge: growth (level 2)
 * Single-population growth demography WITH BACKGROUND SELECTION, per the
 * official GHIST wiki (syn74803798/wiki/640740) - confirmed exonic
 * regions are under purifying selection. Drosophila-like 4-contig genome
 * (2L/2R/3L/3R). Submission schema parameters: generations (T),
 * post_growth_scaling (nu). Shares its coding-regions mask with
 * split_migration (same BED, same BGS setup).
 */
params.genetic_history.challenges.growth = [
    enabled           : params.genetic_history.enabled,
    description       : 'Single-population growth demography, confounded by background selection.',
    input_type        : 'vcf',
    testing_vcf_name       : 'growth.testing.vcf',
    coding_regions_bed: "${params.data_dir}/BGS_demography_challenge_coding_regions.bed",
    submission_schema : "${params.data_dir}/growth.submission.yaml",

    tools: [
        psmc:           [ enabled: true,  status: 'runnable', conda: 'bioconda::psmc bioconda::cyvcf2', args: '-N25 -t15 -r5 -p 4+25*2+4+6',
                           options: [assume_callable: true] ],
        msmc2:          [ enabled: true,  status: 'runnable', conda: 'bioconda::msmc2 bioconda::cyvcf2', args: '',
                           options: [assume_callable: true, mutation_rate: 3.0e-9, population_prefixes: []] ],
        fastsimcoal2:   [
                           enabled: true, status: 'survey',
                           conda: 'bioconda::fastsimcoal2=27093 conda-forge::python=3.11', args: '',
                           options: [
                               population_prefixes: [], mutation_rate: 3.0e-9,
                               assume_callable: true,
                               exclude_bed: "${params.data_dir}/BGS_demography_challenge_coding_regions.bed",
                               simulations: 100000, ecm_cycles: 40, threads: 1,
                               population_size_bounds: [100, 1000000], growth_scale_bounds: [1.01, 100.0],
                               time_bounds: [10, 100000]
                           ],
                           reason: 'Fits an instantaneous size increase in a single-population folded SFS; excludes the configured coding-region BED and treats remaining contig-header bases as callable.'
                       ],
        mrpast:         [
                           enabled: true, status: 'survey',
                           conda: "${projectDir}/conf/genetic_history/mrpast.yml", args: '',
                           options: [
                               population_prefixes: [], mutation_rate: 3.0e-9, recombination_rate: 3.0e-8,
                               assume_ref_ancestral: true, jobs: 1, num_times: 50, replicates: 1,
                               tree_sample_rate: 10000, population_size_bounds: [100, 1000000],
                               time_bounds: [10, 100000],
                               tree_sampling_rate: 1.0e-10, masked_tree_sampling_rate: 1.0e-8,
                               exclude_bed: "${params.data_dir}/BGS_demography_challenge_coding_regions.bed"
                           ],
                           reason: 'Uses the documented dated-ARG workflow; reference alleles are assumed ancestral, coding regions are excluded, and growth is represented as an instantaneous two-epoch size change.'
                       ],
        stairway_plot2: [ enabled: false, status: 'stub', reason: 'Java .jar via GitHub release, no conda/PyPI package - install manually.' ],
        phlash:         [ enabled: false, status: 'stub', reason: 'pip install from GitHub source, no PyPI/conda package found - install manually.' ],
    ]
]

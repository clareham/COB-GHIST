/*
 * Challenge: growth (level 2)
 * Single-population growth demography WITH BACKGROUND SELECTION, per the
 * official GHIST wiki (syn74803798/wiki/640740) - confirmed exonic
 * regions are under purifying selection. Drosophila-like 4-contig genome
 * (2L/2R/3L/3R). Submission schema parameters: generations (T),
 * post_growth_scaling (nu). Shares its coding-regions mask with
 * split_migration (same BED, same BGS setup).
 */
params.genetic_history.challenges.growth = [
    enabled           : params.genetic_history.enabled,
    description       : 'Single-population growth demography, confounded by background selection.',
    input_type        : 'vcf',
    testing_vcf_name       : 'growth.testing.vcf',
    coding_regions_bed: "${params.data_dir}/BGS_demography_challenge_coding_regions.bed",
    submission_schema : "${params.data_dir}/growth.submission.yaml",

    tools: [
        psmc:           [ enabled: true,  status: 'runnable', conda: 'bioconda::psmc bioconda::cyvcf2', args: '-N25 -t15 -r5 -p 4+25*2+4+6' ],
        msmc2:          [ enabled: true,  status: 'runnable', conda: 'bioconda::msmc2 bioconda::cyvcf2', args: '' ],
        fastsimcoal2:   [ enabled: false, status: 'stub', conda: 'bioconda::fastsimcoal2 bioconda::cyvcf2', args: '-n 100000 -L 40 -M',
                           reason: 'Needs a challenge-specific demographic model, matching SFS sample size, and verified folded-SFS invocation.' ],
        mrpast:         [ enabled: false, status: 'stub', conda: 'bioconda::mrpast bioconda::tsinfer bioconda::cyvcf2 bioconda::htslib', args: '',
                           reason: 'Needs a demographic model, population mapping, dated ARG inference, and the documented process/solve workflow.' ],
        stairway_plot2: [ enabled: false, status: 'stub', reason: 'Java .jar via GitHub release, no conda/PyPI package - install manually.' ],
        phlash:         [ enabled: false, status: 'stub', reason: 'pip install from GitHub source, no PyPI/conda package found - install manually.' ],
    ]
]

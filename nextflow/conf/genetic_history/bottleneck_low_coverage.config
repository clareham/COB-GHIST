/*
 * Challenge: bottleneck_low_coverage (level 2)
 * Single-population bottleneck demography, low-coverage sequencing.
 * Input is a single haploid consensus FASTA (no VCF, no reads/BAM).
 */
params.genetic_history.challenges.bottleneck_low_coverage = [
    enabled           : params.genetic_history.enabled,
    description       : 'Single-population bottleneck demography, low-coverage sequencing.',
    input_type        : 'fasta',
    testing_fasta_name      : 'bottleneck_low_coverage.testing.reference.fasta',
    submission_schema : "${params.data_dir}/bottleneck.submission.yaml",

    tools: [
        psmc: [
            enabled: true, status: 'runnable-with-caveat',
            conda  : 'bioconda::psmc',
            args   : '-N25 -t15 -r5 -p 4+25*2+4+6',
            reason : 'Only a single haploid consensus sequence is provided (no second haplotype, no het signal) ' +
                     '- see modules/genetic_history/psmc/main.nf. Output is a structural placeholder, not a ' +
                     'validated inference; a real low-coverage analysis needs reads + genotype likelihoods.'
        ],
        msmc2: [
            enabled: false, status: 'excluded',
            reason : 'MSMC2 needs explicit per-sample phased haplotype pairs (multihetsep format); a single ' +
                     'haploid consensus with no het calls carries no usable signal for it.'
        ],
    ]
]

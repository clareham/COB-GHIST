/*
 * Challenge: bottleneck_low_coverage (level 2)
 * Single-population bottleneck demography, low-coverage sequencing.
 *
 * REAL DATA FORMAT (confirmed from the GHIST wiki,
 * syn74803798/wiki/640740 - not what this pipeline originally assumed):
 * the challenge actually ships a `*.tar.gz` archive of 20 diploid
 * individuals' aligned BAMs (~2x mean depth, paired-end 126bp reads vs.
 * the reference FASTA below) plus a `popfile.txt` (sample -> population),
 * not a bare consensus sequence. "No variant calls, genotypes, or
 * genotype likelihoods are provided. How you get from reads to
 * demography is up to you" (i.e. there's no single prescribed method).
 *
 * NOT YET DOWNLOADED: `bottleneck_low_coverage.testing.tar.gz`
 * (syn77432049) requires Synapse challenge-team authentication this
 * environment doesn't have - place it in `data_dir` once you've
 * downloaded it yourself; GhistUtils.testingFile() will otherwise just
 * warn and skip this challenge. Both tools below are therefore
 * `runnable-unverified`, not `runnable` - the bcftools/samtools
 * invocations follow each tool's own documented standard usage, but
 * haven't been run against this challenge's real reads.
 */
params.genetic_history.challenges.bottleneck_low_coverage = [
    enabled             : params.genetic_history.enabled,
    description         : 'Single-population bottleneck demography, low-coverage sequencing.',
    input_type          : 'bam',
    testing_archive_name: 'bottleneck_low_coverage.testing.tar.gz',
    testing_fasta_name  : 'bottleneck_low_coverage.testing.reference.fasta',
    submission_schema   : "${params.data_dir}/bottleneck.submission.yaml",

    tools: [
        psmc: [
            enabled: true, status: 'runnable-unverified',
            conda  : 'bioconda::psmc bioconda::bcftools bioconda::samtools',
            args   : '-N25 -t15 -r5 -p 4+25*2+4+6',
            options: [min_depth: 1, max_depth: 10],
            reason : 'Real BAM-based input now (bin/bam_sample_to_psmcfa.sh, PSMC\'s own documented usage) - ' +
                     'untested pending the archive download (see note above).'
        ],
        msmc2: [
            enabled: true, status: 'runnable-unverified',
            conda  : 'bioconda::msmc2 bioconda::bcftools bioconda::samtools bioconda::bedtools bioconda::cyvcf2 bioconda::htslib',
            args   : '',
            options: [assume_callable: false, mutation_rate: 1.25e-8, min_depth: 1, max_depth: 10],
            reason : 'Real BAM-based input now, with a genuine depth-based callability mask ' +
                     '(bin/bam_to_depth_mask.py) instead of the "no mask available" caveat that applied when ' +
                     'only a bare consensus FASTA was available - untested pending the archive download.'
        ],
    ]
]

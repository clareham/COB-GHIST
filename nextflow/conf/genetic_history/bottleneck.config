/*
 * Challenge: bottleneck (level 2)
 * Single-population bottleneck demography. VCF-only, single contig.
 * Submission schema parameters: generations (T), post_decline_fraction (nu).
 *
 * `tools {}` below is level 3: one block per tool workflow that can be
 * run against this challenge's testing data.
 */
params.genetic_history.challenges.bottleneck = [
    enabled           : params.genetic_history.enabled,
    description       : 'Single-population bottleneck demography.',
    input_type        : 'vcf',
    testing_vcf_name       : 'bottleneck.testing.vcf',
    submission_schema : "${params.data_dir}/bottleneck.submission.yaml",

    tools: [
        psmc: [
            enabled: true, status: 'runnable',
            conda  : 'bioconda::psmc bioconda::cyvcf2',
            args   : '-N25 -t15 -r5 -p 4+25*2+4+6',
            options: [assume_callable: true]
        ],
        msmc2: [
            enabled: true, status: 'runnable',
            conda  : 'bioconda::msmc2 bioconda::cyvcf2',
            args   : '',
            options: [assume_callable: true, mutation_rate: 1.25e-8, population_prefixes: []]
        ],
        fastsimcoal2: [
            enabled: true, status: 'survey',
            conda  : 'bioconda::fastsimcoal2=27093 conda-forge::python=3.11',
            args   : '',
            options: [
                population_prefixes: [], mutation_rate: 1.25e-8,
                assume_callable: true, simulations: 100000, ecm_cycles: 40, threads: 1,
                population_size_bounds: [100, 1000000], fraction_bounds: [0.01, 1.0],
                time_bounds: [10, 100000]
            ],
            reason : 'Fits a one-population folded SFS to an instantaneous size change; contig header lengths are assumed callable and population sizes are reported in diploid individuals.'
        ],
        mrpast: [
            enabled: true, status: 'survey',
            conda  : "${projectDir}/conf/genetic_history/mrpast.yml",
            args   : '',
            options: [
                population_prefixes: [], mutation_rate: 1.25e-8, recombination_rate: 1.0e-8,
                assume_ref_ancestral: true, jobs: 1, num_times: 50, replicates: 1,
                tree_sample_rate: 10000, population_size_bounds: [100, 1000000],
                time_bounds: [10, 100000]
            ],
            reason : 'Uses documented mrpast arginfer (tsinfer plus tsdate) and process --solve; reference alleles are assumed ancestral and the single event is an instantaneous two-epoch size change.'
        ],
        stairway_plot2: [
            enabled: false, status: 'stub',
            reason : 'Distributed as a Java .jar via GitHub release, no conda/PyPI package. Install manually, point `jar` at the local copy, then flip enabled: true.'
        ],
        phlash: [
            enabled: false, status: 'stub',
            reason : 'Python package installed from the GitHub source tree (no PyPI/conda package found). pip install manually, then flip enabled: true.'
        ],
    ]
]

/*
 * Challenge: secondary_contact (level 2)
 * Mainland-island population split with delayed migration (2 populations).
 * Submission schema parameters: mainland_population_size (N1),
 * island_population_size (N2), generations_since_split (T1),
 * generations_since_migration (T2), migration_rate (M).
 */
params.genetic_history.challenges.secondary_contact = [
    enabled           : params.genetic_history.enabled,
    description       : 'Mainland-island population split and delayed migration.',
    input_type        : 'vcf',
    testing_vcf_name       : 'secondary_contact.testing.vcf',
    submission_schema : "${params.data_dir}/secondary_contact.submission.yaml",

    tools: [
        psmc:           [ enabled: true,  status: 'runnable', conda: 'bioconda::psmc bioconda::cyvcf2', args: '-N25 -t15 -r5 -p 4+25*2+4+6',
                           options: [assume_callable: true] ],
        msmc2:          [ enabled: true,  status: 'runnable', conda: 'bioconda::msmc2 bioconda::cyvcf2', args: '',
                           options: [assume_callable: true, mutation_rate: 1.25e-8, population_prefixes: ['mainland_', 'island_']] ],
        fastsimcoal2:   [
                           enabled: true, status: 'survey',
                           conda: 'bioconda::fastsimcoal2=27093 conda-forge::python=3.11', args: '',
                           options: [
                               population_prefixes: ['mainland_', 'island_'], mutation_rate: 1.25e-8,
                               assume_callable: true, assume_ref_ancestral: true, migration_mode: 'symmetric',
                               ancestral_size_rule: 'population_0', contact_age_ratio_bounds: [0.01, 0.99],
                               simulations: 100000, ecm_cycles: 40, threads: 1,
                               population_size_bounds: [100, 1000000], migration_rate_bounds: [1.0e-8, 0.1],
                               time_bounds: [10, 100000]
                           ],
                           reason: 'Fits the mainland/island joint SFS with symmetric migration from T2 to T1 and isolation from T1 to T2; sizes are diploid individuals and all header-declared bases are assumed callable.'
                       ],
        mrpast:         [
                           enabled: true, status: 'survey',
                           conda: "${projectDir}/conf/genetic_history/mrpast.yml", args: '',
                           options: [
                               population_prefixes: ['mainland_', 'island_'], mutation_rate: 1.25e-8,
                               recombination_rate: 1.0e-8, assume_ref_ancestral: true,
                               jobs: 1, num_times: 50, replicates: 1, tree_sample_rate: 10000,
                               population_size_bounds: [100, 1000000], migration_rate_bounds: [1.0e-8, 0.1],
                               recent_time_bounds: [10, 9000], old_time_bounds: [10000, 100000],
                               initial_migration_rate: 0.001, ancestral_migration_rate: 0.1,
                               tree_sampling_rate: 1.0e-10, masked_tree_sampling_rate: 1.0e-8
                           ],
                           reason: 'Uses dated ARG inference and mrpast process --solve; the oldest panmictic ancestor is approximated by configured high symmetric migration, with T2 constrained more recent than T1.'
                       ],
        stairway_plot2: [ enabled: false, status: 'stub', reason: 'Java .jar via GitHub release, no conda/PyPI package - install manually.' ],
        phlash:         [ enabled: false, status: 'stub', reason: 'pip install from GitHub source, no PyPI/conda package found - install manually.' ],
        fastglobetrotter: [ enabled: false, status: 'stub',
                           reason: 'LD-based admixture-dating method, relevant here (post-contact migration), but needs a from-source install - no conda/PyPI package found.' ],
        archie2:        [ enabled: false, status: 'stub',
                           reason: 'Introgression-detection tool; tangential fit for a mainland-island scenario, and needs a from-source install. Disabled by default even once installed - enable deliberately.' ],
    ]
]

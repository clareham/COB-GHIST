/*
 * Category: Genetic History
 * ---------------------------------------------------------------------
 * Level 1 of the config hierarchy. This file only sets category-wide
 * defaults and pulls in one config per challenge (level 2); the per-tool
 * blocks (level 3) live inside each challenge config.
 */

params.genetic_history = [
    enabled   : params.run_genetic_history,
    challenges: [:]
]

includeConfig 'bottleneck.config'
includeConfig 'bottleneck_low_coverage.config'
includeConfig 'growth.config'
includeConfig 'secondary_contact.config'
includeConfig 'split_migration.config'
includeConfig 'split_isolation_low_coverage.config'

/*
 * Challenge: split_migration (level 2)
 * Population split between continental Africa and Europe, with migration.
 * Drosophila-like 4-contig genome (2L/2R/3L/3R), coding-region mask
 * available (BGS_demography_challenge_coding_regions.bed).
 * Submission schema parameters: AFR_population_size (N1),
 * EUR_population_size (N2), generations_since_split (T1), migration_rate (M).
 */
params.genetic_history.challenges.split_migration = [
    enabled           : params.genetic_history.enabled,
    description       : 'Population split between continental Africa and Europe, with migration.',
    input_type        : 'vcf',
    testing_vcf_name       : 'split_migration.testing.vcf',
    coding_regions_bed: "${params.data_dir}/BGS_demography_challenge_coding_regions.bed",
    submission_schema : "${params.data_dir}/split_migration.submission.yaml",

    tools: [
        psmc:           [ enabled: true,  status: 'runnable', conda: 'bioconda::psmc bioconda::cyvcf2', args: '-N25 -t15 -r5 -p 4+25*2+4+6',
                           options: [assume_callable: true] ],
        msmc2:          [ enabled: true,  status: 'runnable', conda: 'bioconda::msmc2 bioconda::cyvcf2', args: '',
                           options: [assume_callable: true, mutation_rate: 3.0e-9, population_prefixes: ['AFR_', 'EUR_']] ],
        fastsimcoal2:   [
                           enabled: true, status: 'survey',
                           conda: 'bioconda::fastsimcoal2=27093 conda-forge::python=3.11', args: '',
                           options: [
                               population_prefixes: ['AFR_', 'EUR_'], mutation_rate: 3.0e-9,
                               assume_callable: true, assume_ref_ancestral: true, migration_mode: 'symmetric',
                               ancestral_size_rule: 'population_0',
                               exclude_bed: "${params.data_dir}/BGS_demography_challenge_coding_regions.bed",
                               simulations: 100000, ecm_cycles: 40, threads: 1,
                               population_size_bounds: [100, 1000000], migration_rate_bounds: [1.0e-8, 0.1],
                               time_bounds: [10, 100000]
                           ],
                           reason: 'Fits the AFR/EUR joint SFS with symmetric migration until T1 and an instantaneous split; excludes coding regions and assumes remaining header-declared bases are callable.'
                       ],
        mrpast:         [
                           enabled: true, status: 'survey',
                           conda: "${projectDir}/conf/genetic_history/mrpast.yml", args: '',
                           options: [
                               population_prefixes: ['AFR_', 'EUR_'], mutation_rate: 3.0e-9,
                               recombination_rate: 3.0e-8, assume_ref_ancestral: true,
                               jobs: 1, num_times: 50, replicates: 1, tree_sample_rate: 10000,
                               population_size_bounds: [100, 1000000], migration_rate_bounds: [1.0e-8, 0.1],
                               time_bounds: [10, 100000], initial_migration_rate: 0.001,
                               ancestral_migration_rate: 0.1, tree_sampling_rate: 1.0e-10,
                               masked_tree_sampling_rate: 1.0e-8,
                               exclude_bed: "${params.data_dir}/BGS_demography_challenge_coding_regions.bed"
                           ],
                           reason: 'Uses the dated-ARG workflow; the oldest panmictic ancestor is approximated by configured high symmetric migration and coding regions are excluded.'
                       ],
        stairway_plot2: [ enabled: false, status: 'stub', reason: 'Java .jar via GitHub release, no conda/PyPI package - install manually.' ],
        phlash:         [ enabled: false, status: 'stub', reason: 'pip install from GitHub source, no PyPI/conda package found - install manually.' ],
        fastglobetrotter: [ enabled: false, status: 'stub',
                           reason: 'LD-based admixture-dating method, relevant here (post-split migration), but needs a from-source install - no conda/PyPI package found.' ],
    ]
]

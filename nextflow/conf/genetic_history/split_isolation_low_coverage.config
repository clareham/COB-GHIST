/*
 * Challenge: split_isolation_low_coverage (level 2)
 * Two-population split with no migration, low-coverage sequencing.
 *
 * REAL DATA FORMAT (confirmed from the GHIST wiki,
 * syn74803798/wiki/640740 - not what this pipeline originally assumed):
 * a `*.tar.gz` archive of 20 diploid individuals' aligned BAMs
 * (~4x mean depth) - 10 from `pop1`, 10 from `pop2` per `popfile.txt` -
 * plus the reference FASTA below. "No variant calls, genotypes, or
 * genotype likelihoods are provided. How you get from reads to
 * demography is up to you."
 *
 * NOT YET DOWNLOADED: `split_isolation_low_coverage.testing.tar.gz`
 * (syn77432188) requires Synapse challenge-team authentication this
 * environment doesn't have - place it in `data_dir` once you've
 * downloaded it yourself; GhistUtils.testingFile() will otherwise just
 * warn and skip this challenge. Both tools below are therefore
 * `runnable-unverified`, not `runnable`.
 */
params.genetic_history.challenges.split_isolation_low_coverage = [
    enabled             : params.genetic_history.enabled,
    description         : 'Two-population split with no migration, low-coverage sequencing.',
    input_type          : 'bam',
    testing_archive_name: 'split_isolation_low_coverage.testing.tar.gz',
    testing_fasta_name  : 'split_isolation_low_coverage.testing.reference.fasta',
    submission_schema   : "${params.data_dir}/split_isolation_low_coverage.submission.yaml",

    tools: [
        psmc: [
            enabled: true, status: 'runnable-unverified',
            conda  : 'bioconda::psmc bioconda::bcftools bioconda::samtools',
            args   : '-N25 -t15 -r5 -p 4+25*2+4+6',
            reason : 'Real BAM-based input now, but PSMC is still a single-individual method - it picks the ' +
                     'first popfile.txt sample (whichever population happens to be listed first) and reports ' +
                     'only that one population\'s curve, not a joint split-time estimate. Untested pending the ' +
                     'archive download (see note above).'
        ],
        msmc2: [
            enabled: true, status: 'runnable-unverified',
            conda  : 'bioconda::msmc2 bioconda::bcftools bioconda::samtools bioconda::bedtools bioconda::cyvcf2 bioconda::htslib',
            args   : '',
            reason : 'Picks one individual from each population, but currently pools all haplotype pairs. ' +
                     'Split-time inference still needs phase handling and separate within/cross-population ' +
                     'runs; this is not yet a valid split-time estimate. Untested against real BAMs.'
        ],
    ]
]

/*
 * Challenge: split_isolation_low_coverage (level 2)
 * Two-population split with no migration, low-coverage sequencing.
 * Input is a single haploid consensus FASTA (no VCF, no reads/BAM) -
 * same structural situation as bottleneck_low_coverage.
 */
params.genetic_history.challenges.split_isolation_low_coverage = [
    enabled           : params.genetic_history.enabled,
    description       : 'Two-population split with no migration, low-coverage sequencing.',
    input_type        : 'fasta',
    testing_fasta_name      : 'split_isolation_low_coverage.testing.reference.fasta',
    submission_schema : "${params.data_dir}/split_isolation_low_coverage.submission.yaml",

    tools: [
        psmc: [
            enabled: true, status: 'runnable-with-caveat',
            conda  : 'bioconda::psmc',
            args   : '-N25 -t15 -r5 -p 4+25*2+4+6',
            reason : 'Only a single haploid consensus sequence is provided for what is nominally a 2-population ' +
                     'model - PSMC can only ever report a single-population coalescent curve from this, not a ' +
                     'split time/two population sizes. Structural placeholder, not a validated inference.'
        ],
        msmc2: [
            enabled: false, status: 'excluded',
            reason : 'MSMC2 needs explicit per-sample phased haplotype pairs (multihetsep format); a single ' +
                     'haploid consensus with no het calls carries no usable signal for it.'
        ],
    ]
]

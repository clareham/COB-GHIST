/*
 * GHIST 2026 survey pipeline
 * -----------------------------------------------------------------------
 * Config hierarchy (mirrors the directory layout under conf/ and modules/):
 *
 *   1. category   conf/<category>/<category>.config
 *   2. challenge  conf/<category>/<challenge>.config
 *   3. tool       a `tools { <tool_name> { ... } }` block inside each
 *                 challenge config, one entry per tool workflow that can
 *                 be run against that challenge's data.
 *
 * Only `*.testing.*` files are ever wired up as process input. The
 * `*.final.*` files are held-out scoring data and must never be read by
 * this pipeline - see conf/base.config (`assert_no_final_leakage`).
 */

params {
    // Root folder containing the GHIST2026 data dump. Now lives inside
    // this repo (../data relative to this pipeline, i.e. COB-GHIST/data/
    // - see pysrc/synapse_retrieval.py), rather than the old sibling
    // data-GHIST2026/ folder. Overridable via GHIST_DATA_DIR /
    // GHIST_OUTDIR env vars so this git-tracked file never needs a
    // local, machine-specific edit.
    data_dir = System.getenv('GHIST_DATA_DIR') ?: "${projectDir}/../data"
    outdir   = System.getenv('GHIST_OUTDIR')   ?: "${projectDir}/results"

    // Top-level on/off switch per challenge category. Flip these to scope
    // a run down to a single family of challenges while surveying tools.
    run_genetic_history  = true
    run_sweep_detection  = true
    run_relatedness      = true
}

includeConfig 'conf/base.config'
includeConfig 'conf/genetic_history/genetic_history.config'
includeConfig 'conf/sweep_detection/sweep_detection.config'
includeConfig 'conf/relatedness/relatedness.config'

profiles {
    conda {
        conda.enabled = true
        // Resolve every package-list environment from exactly these
        // channels, ignoring whatever the machine's ~/.condarc adds (e.g.
        // `defaults`, which fails non-interactively under the Anaconda ToS
        // and can pull incompatible builds). mrpast.yml declares its own
        // channels, including `nodefaults`.
        conda.channels      = ['conda-forge', 'bioconda']
        conda.createOptions = '--override-channels'
        // Nextflow kills environment creation after `createTimeout`
        // (default 20 min). The FlexSweep (TensorFlow) and mrpast
        // (tsinfer/tsdate/numba) environments routinely need longer on a
        // fresh machine, which surfaces as every task of that tool failing.
        conda.createTimeout = '3 h'
        // Keep solved environments outside work/ so `nextflow clean` or a
        // fresh work directory does not force a rebuild (and a new timeout
        // window) for every tool. Override with NXF_CONDA_CACHEDIR.
        conda.cacheDir      = System.getenv('NXF_CONDA_CACHEDIR') ?: "${projectDir}/.conda-envs"
    }
    docker {
        docker.enabled = true
    }
}

manifest {
    name            = 'COB-GHIST-survey'
    description     = 'Early-survey Nextflow pipeline across the GHIST 2026 challenge set'
    nextflowVersion = '>=24.04.0'
}

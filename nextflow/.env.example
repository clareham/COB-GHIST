# Copy this file to .env and adjust paths for your machine, then load it
# into your shell before running Nextflow (see nextflow/README.md,
# "Local path overrides" - Nextflow itself does not auto-load .env files).
#
# Both are optional; nextflow.config falls back to the repo-relative
# defaults (../data, ./results) if unset.

GHIST_DATA_DIR=/absolute/path/to/data
GHIST_OUTDIR=/absolute/path/to/results
